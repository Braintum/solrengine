{
	"name": "solrengine/solrengine",
	"description": "Apache Solr powered search for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://www.solrengine.com",
	"require": {
		"php": ">=7.4",
		"woocommerce/action-scheduler": "^3.9"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.5",
		"php-stubs/wp-cli-stubs": "^2.10",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.9",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.0",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"SolrEngine\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SolrEngine\\Tests\\": "tests/"
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse",
		"test": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration",
		"check": [
			"@lint",
			"@analyse",
			"@test"
		]
	},
	"scripts-descriptions": {
		"lint": "Check coding standards with PHP_CodeSniffer.",
		"lint:fix": "Auto-fix coding standard violations where possible.",
		"analyse": "Run PHPStan static analysis.",
		"test": "Run the unit test suite (no WordPress or Solr required).",
		"test:integration": "Run the WordPress integration test suite.",
		"check": "Run lint, static analysis and unit tests."
	}
}
