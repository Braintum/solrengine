<?xml version="1.0" encoding="UTF-8"?>
<!--
  SolrEngine solrconfig.xml.

  Deliberately close to Solr's default. SolrEngine has opinions about its
  schema, not about how a customer runs their server, and every setting added
  here is one more thing that can conflict with their operational choices.

  Licensed under the Apache License, Version 2.0.
-->
<config>

  <luceneMatchVersion>9.10</luceneMatchVersion>

  <dataDir>${solr.data.dir:}</dataDir>
  <directoryFactory name="DirectoryFactory" class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}"/>
  <codecFactory class="solr.SchemaCodecFactory"/>

  <!--
    Managed schema. Required for the Schema API, which is how SolrEngine adds
    its fields with an administrator's confirmation rather than by hand.
  -->
  <schemaFactory class="ManagedIndexSchemaFactory">
    <bool name="mutable">true</bool>
    <str name="managedSchemaResourceName">managed-schema.xml</str>
  </schemaFactory>

  <indexConfig>
    <lockType>${solr.lock.type:native}</lockType>
  </indexConfig>

  <updateHandler class="solr.DirectUpdateHandler2">
    <updateLog>
      <str name="dir">${solr.ulog.dir:}</str>
    </updateLog>

    <!--
      SolrEngine sends commitWithin on every write rather than committing per
      document, so these exist as a safety net, not as the primary mechanism.
      openSearcher is false so an autoCommit does not pay for a new searcher;
      the soft commit below handles visibility.
    -->
    <autoCommit>
      <maxTime>${solr.autoCommit.maxTime:60000}</maxTime>
      <openSearcher>false</openSearcher>
    </autoCommit>

    <autoSoftCommit>
      <maxTime>${solr.autoSoftCommit.maxTime:15000}</maxTime>
    </autoSoftCommit>
  </updateHandler>

  <query>
    <filterCache class="solr.CaffeineCache" size="512" initialSize="512" autowarmCount="128"/>
    <queryResultCache class="solr.CaffeineCache" size="512" initialSize="512" autowarmCount="0"/>
    <documentCache class="solr.CaffeineCache" size="512" initialSize="512" autowarmCount="0"/>
    <queryResultWindowSize>20</queryResultWindowSize>
    <useColdSearcher>true</useColdSearcher>
  </query>

  <requestDispatcher>
    <httpCaching never304="true"/>
  </requestDispatcher>

  <requestHandler name="/select" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">none</str>
      <int name="rows">10</int>
      <!--
        No default df. SolrEngine always sends an explicit query built from its
        own field list; a default field here would silently change relevance
        for anyone who forgot one.
      -->
    </lst>
  </requestHandler>

  <requestHandler name="/update" class="solr.UpdateRequestHandler"/>

  <!-- Used by the connection diagnostic. -->
  <requestHandler name="/admin/ping" class="solr.PingRequestHandler">
    <lst name="invariants">
      <str name="q">*:*</str>
    </lst>
    <lst name="defaults">
      <str name="echoParams">none</str>
    </lst>
  </requestHandler>

</config>
