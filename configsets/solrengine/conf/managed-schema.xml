<?xml version="1.0" encoding="UTF-8"?>
<!--
  SolrEngine managed schema.

  GENERATED FILE. The field definitions below come from
  SolrEngine\Schema\ContractRegistry, which is the same source that drives the
  Schema API plan and the export shown in wp-admin. Regenerate with:

      wp solrengine schema export

  Editing this by hand is fine for your own additions, but changes to the "se_"
  fields will be reported as drift by the connection diagnostic.

  Licensed under the Apache License, Version 2.0, matching Apache Solr's own
  example configsets from which the field types below are taken.
-->
<schema name="solrengine" version="1.6">

  <uniqueKey>id</uniqueKey>

  <!-- Required by Solr itself. -->
  <field name="id" type="string" indexed="true" stored="true" required="true" multiValued="false"/>
  <field name="_version_" type="plong" indexed="false" stored="false"/>

  <!-- =====================================================================
       Field types. Standard definitions from Solr's default configset,
       reproduced here so a collection created from this configset needs
       nothing else.
       ===================================================================== -->

  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true"/>
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true"/>
  <fieldType name="pint" class="solr.IntPointField" docValues="true"/>
  <fieldType name="plong" class="solr.LongPointField" docValues="true"/>
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true"/>
  <fieldType name="pdouble" class="solr.DoublePointField" docValues="true"/>
  <fieldType name="pdate" class="solr.DatePointField" docValues="true"/>

  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100" multiValued="true">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt"/>
      <filter class="solr.SynonymGraphFilterFactory" synonyms="synonyms.txt" ignoreCase="true" expand="true"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>


  <!-- =====================================================================
       Language analysers.

       One per language, used by SolrEngine's per-language analysed fields
       (se_txten_*, se_txtde_*, and so on). A language listed here can be
       analysed properly: German compounds are normalised, English words are
       stemmed, Turkish is lower-cased by the rules Turkish actually uses
       rather than the ones everyone else does.

       These are field TYPES only. The fields that use them are added per site,
       because which languages a site publishes in is that site's business:
       enable them under SolrEngine -> Search, or run
       "wp solrengine schema apply". A language with no type here is still
       indexed and still searchable through the language-neutral fields; the
       only thing it loses is stemming.

       Deliberately no stopword filters. Solr's own language configsets each
       reference a file such as lang/stopwords_de.txt, and a schema referencing
       a file that is not there does not degrade — the core fails to load. Rather
       than ship two dozen third-party word lists, these types normalise and
       stem only. Add a StopFilterFactory yourself if you want one; it is a
       smaller win than stemming.

       Every filter used below ships with Solr in lucene-analysis-common. None
       needs an extra module, which is why languages requiring one — Japanese,
       Chinese, Korean, Thai — are absent rather than half-configured.
       ===================================================================== -->

  <!-- Arabic -->
  <fieldType name="text_ar" class="solr.TextField" positionIncrementGap="100" multiValued="true">
    <analyzer>
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.LowerCaseFilterFactory"/>
      <filter class="solr.ArabicNormalizationFilterFactory"/>
      <filter class="solr.ArabicStemFilterFactory"/>
    </analyzer>
  </fieldType>

