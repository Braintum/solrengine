# Files excluded from the distributed plugin package.
# WordPress.org guideline: ship no tests, no examples, no build tooling,
# no debug pages. See plan Appendix A item A15.

.git
.github
.gitignore
.distignore
.editorconfig
.claude
.legacy

# The package directory itself. Without this, rsync copies the destination
# into the destination and the zip contains a partial copy of itself.
build

# Development tooling
composer.json
composer.lock
package.json
package-lock.json
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist
phpunit.xml
phpunit.xml.dist
.phpunit.cache
.phpunit.result.cache

# Sources and tests. assets/build is NOT excluded: WordPress.org distributes a
# zip rather than running a build, so the compiled files are what ships.
# assets/src stays in the repository, which guideline 4 requires alongside it.
tests
bin
docs
assets/src
assets/README.md
node_modules
webpack.config.js
.eslintrc.json
.npm-cache
