# Files excluded from the distributed plugin package.
# WordPress.org guideline: ship no tests, no examples, no build tooling,
# no debug pages. See plan Appendix A item A15.

.git
.github
.gitignore
.distignore
.editorconfig
.claude
.legacy

# The package directory itself. Without this, rsync copies the destination
# into the destination and the zip contains a partial copy of itself.
build

# Development tooling.
#
# composer.json is NOT excluded. Plugin Check reports a vendor/ directory with no
# composer.json beside it, and it is right to: without the manifest there is no
# way for a reviewer to see what the bundled code is meant to be. It is two
# kilobytes and it makes vendor/ auditable.
composer.lock
package.json
package-lock.json
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist
phpunit.xml
phpunit.xml.dist
.phpunit.cache
.phpunit.result.cache

# Sources and tests. assets/build is NOT excluded: WordPress.org distributes a
# zip rather than running a build, so the compiled files are what ships.
# assets/src stays in the repository, which guideline 4 requires alongside it.
tests
bin
docs
# The developer-facing readme, which is a table of contents for docs/ — excluded
# just above. Shipping it would put a page of dead links in the package.
# readme.txt is the one users and the directory read, and that does ship.
README.md
# Instructions for contributors and for coding agents. Neither belongs in a
# release, and Plugin Check refuses unexpected markdown in the plugin root.
AGENTS.md
CLAUDE.md
assets/src
assets/README.md
# Placeholders that exist so git tracks an otherwise empty directory. They have
# no meaning outside the repository, and Plugin Check refuses hidden files
# outright — a blocking error, not a style note.
.gitkeep
node_modules
webpack.config.js
.eslintrc.json
.npm-cache
